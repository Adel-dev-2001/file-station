# ─────────────────────────────────────────────────────────────────────────────
# File Station — Environment Variables Template
# Copy this file to `.env` and fill in the required values.
# NEVER commit a real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Gemini API (Optional) ───────────────────────────────────────────────────
# Required only if you add AI-powered features (currently not used).
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── App URL (Optional) ──────────────────────────────────────────────────────
# The public URL of the deployed application (e.g. for self-referential links).
APP_URL=http://localhost:3000
